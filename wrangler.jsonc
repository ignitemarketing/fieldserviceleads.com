{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fieldserviceleads",
  "compatibility_date": "2026-07-01",
  // Only /api/* runs the Worker first; every other path is served straight
  // from the static assets (and their _headers), with the 404 page for misses.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Waitlist signups, one key per email (signup:<email>). The id is pinned
  // because the deploy token cannot list or create KV namespaces.
  "kv_namespaces": [
    { "binding": "WAITLIST", "id": "854d4d17133b45608fa610f739f205a6" }
  ],
  // 5 waitlist posts per client IP per 60 s.
  "ratelimits": [
    {
      "name": "WAITLIST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
