# Custom response headers for Cloudflare Workers Static Assets.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Astro fingerprints its build output, so anything under /_astro/ can be cached
# forever. HTML is deliberately left at the Workers default
# (public, max-age=0, must-revalidate) so a deploy is visible on the next visit.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400

# Security headers for every response. The Waitlist script is emitted as an
# external /_astro/ file (vite.build.assetsInlineLimit: 0 in astro.config.mjs),
# so script-src is 'self' plus Cloudflare Turnstile (challenges.cloudflare.com, also in
# frame-src) with no hashes; the JSON-LD block is data, not
# script, and CSP does not apply to it. Fonts are self-hosted under /_astro/.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
