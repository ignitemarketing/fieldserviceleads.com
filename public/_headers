# Custom response headers for Cloudflare Workers Static Assets.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Astro fingerprints its build output, so anything under /_astro/ can be cached
# forever. HTML is deliberately left at the Workers default
# (public, max-age=0, must-revalidate) so a deploy is visible on the next visit.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400
